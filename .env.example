# --- Database Configuration ---
# Use 'db' as host when running in Docker, '127.0.0.1' for local
DATABASE_NAME=sentinel_ids
DATABASE_USER=user
DATABASE_PASSWORD=password
DATABASE_HOST=db
DATABASE_PORT=3306

# --- Redis Configuration ---
# Use 'redis' as host when running in Docker, '127.0.0.1' for local
REDIS_HOST=redis
REDIS_PORT=6379

# --- Django Settings ---
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- CORS Settings ---
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI & External APIs ---
GEMINI_API_KEY=your-gemini-api-key
AI_ENABLED=False

# --- Frontend (Only used during build or in Docker Compose) ---
VITE_API_URL=http://localhost:8000/api/
VITE_WS_URL=ws://localhost:8000/ws/live-feed/
