# --- Database Configuration ---
# Use 'db' as host when running in Docker, '127.0.0.1' for local
DATABASE_NAME=sentinel_ids
DATABASE_USER=sentinel
DATABASE_PASSWORD=sentinel
DATABASE_HOST=db
DATABASE_PORT=3306

# --- Redis Configuration ---
# Use 'redis' as host when running in Docker, '127.0.0.1' for local
REDIS_HOST=redis
REDIS_PORT=6379

# --- AI & External APIs ---
GEMINI_API_KEY=your-gemini-api-key-here
AI_ENABLED=True

# --- Django Settings ---
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# --- CORS & Security Settings ---
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://0.0.0.0:5173,http://[dockerIp]:5173    
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://0.0.0.0:5173,http://[dockerIp]:5173    
# --- AI & External APIs ---
GEMINI_API_KEY=your-gemini-api-key
AI_ENABLED=True

# --- Default Superuser ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Frontend (Only used during build or in Docker Compose) ---
VITE_API_URL=http://localhost:8000/api/
VITE_WS_URL=ws://localhost:8000/ws/live-feed/
